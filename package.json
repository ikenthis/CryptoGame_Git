{
  "name": "bellum-gentium",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test packages/engine/test/*.test.ts apps/server/test/*.test.ts tools/**/*.test.ts",
    "art": "node tools/art/generate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "dev:server": "node apps/server/src/main.ts",
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "start": "npm run build:web && node apps/server/src/main.ts",
    "build:demo": "cd apps/web && node build-demo.mjs",
    "telegram:setup": "node --env-file-if-exists=.env tools/telegram/setup.ts",
    "telegram:announce": "node --env-file-if-exists=.env tools/telegram/announce.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^22.10.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.0"
  }
}
