# Copia este archivo a .env y arranca con: node --env-file=.env apps/server/src/main.ts
# Nunca subas .env al repositorio (ya está en .gitignore).

# --- Servidor ---
PORT=8787
# En producción (NODE_ENV=production) ADMIN_TOKEN, SESSION_SECRET y DATA_DIR son obligatorios.
NODE_ENV=production
# Genera cada secreto con: openssl rand -hex 32
ADMIN_TOKEN=
SESSION_SECRET=
# Carpeta donde se guardan torneos, perfiles y mercado (en Docker: /data, montado como volumen).
DATA_DIR=data
# 1 = solo jugadores con Telegram pueden inscribirse en torneos (recomendado en producción).
REQUIRE_AUTH=1
# Peticiones POST por minuto e IP.
RATE_LIMIT=120
# 1 solo si el servidor está detrás de un proxy propio (Render, Railway, Fly, Caddy, Nginx…).
TRUST_PROXY=1
# Pozo diario de la arena, en unidades mínimas de USDC (25 USDC = 25000000).
DAILY_SPONSOR_POOL=0

# --- Telegram ---
# Token de @BotFather.
TELEGRAM_BOT_TOKEN=
# Dirección HTTPS pública del juego (sin barra final).
PUBLIC_URL=https://tu-dominio.com
# Secreto del webhook: 16-256 caracteres [A-Za-z0-9_-]. openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Canal donde el servidor publica anuncios automáticos (@canal o id numérico). El bot debe ser admin.
TELEGRAM_CHANNEL=
# Enlace directo a la Mini App (de /newapp en BotFather), p. ej. https://t.me/tu_bot/jugar
TELEGRAM_APP_LINK=

# --- Ilustraciones (npm run art). Basta con una de las dos. ---
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
